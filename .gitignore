my_tkinter_app/knowledge/_sources/*.pdf
my_tkinter_app/knowledge/_sources/*.txt
my_tkinter_app/knowledge/_sources/*.html
my_tkinter_app/knowledge/_sources/*.json
!my_tkinter_app/knowledge/_sources/manifest.json

# Extracted-text cache for the cited sources. Content-addressed and rebuilt
# on demand; 5 MB of derived data that must not be reviewed as source.
my_tkinter_app/knowledge/_sources/.cache/

# Case output. Now written to a per-run temp workspace and deleted on exit;
# these are leftovers from before that change.
my_tkinter_app/ForenXAI_Cases/

# Built handoff bundle. 156 MB with sources, 77 MB with --no-sources; both are
# reproduced by `python my_tkinter_app/make_handoff.py`. Ships on Drive.
ForenXAI_UI_Handoff/

# Clone of github.com/OWASP/Top10, 564 MB, kept only so fetch_knowledge.py can
# re-derive knowledge/_sources/OWASP_Top10_2025_FULL/. Re-clone, don't commit.
my_tkinter_app/Top10/

# Exported model weights. export_model.py writes these, and its default
# output is inside the tree; 4.7 GB for 7b, 1.9 GB for 3b. They are a copy
# of what Ollama already holds, reproducible in one command, and far past
# GitHub's 100 MB file limit.
*.gguf
